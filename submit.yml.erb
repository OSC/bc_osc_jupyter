<%-
-%>
---
batch_connect:
  template: "basic"
  conn_params:
    - jupyter_api
script:
  <%- if global_gpus.to_i > 0 -%>
  gpus_per_node: <%= global_gpus %>
  <%- end %>
  native:
  - "--nodes"
  - "<%= bc_num_nodes.to_i %>"
  - "--ntasks-per-node"
  - "<%= global_num_cores.to_i %>"
  - "--partition"
  <%- if global_gpus.to_i > 0 -%>
  - "<%= global_gpu_type.split('-').drop(1).join('-') %>"
  <%- else %>
  - "batch"
  <%- end %>
  <%- if global_enable_mem.to_i == 1  -%>
  - "--mem"
  - "<%= global_mem.to_i%>G"
  <%- end %>
